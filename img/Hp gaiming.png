                    <!-- ko if: isEmpty == false --><!-- /ko -->
                    <!-- ko if: isEmpty == true -->
                    <li class="empty odd" data-product-id="">
                        <div class="add-product">Agregar producto <br></div>
                    </li>
                    <!-- /ko -->
                    
                    <!-- ko if: isEmpty == false --><!-- /ko -->
                    <!-- ko if: isEmpty == true -->
