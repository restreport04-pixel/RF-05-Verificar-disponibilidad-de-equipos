<script>
    require(['jquery', 'contactUs'], function($) {
        window._inside = window._inside || [];
        var chatLoaded = false;
        const container = '.contact-us-container';
        window._inside.push({
            "action": "bind",
            "name": "chatavailable",
            "callback": function(available) {
                chatLoaded = true;
                if (available) {
                    if (chatRequested) {
                        insideFrontInterface.openChatPane();
                    }
                } else {}
                chatRequested = false;
            }
        });
        var openChatButtonOnClick = function() {
            if (chatLoaded) {
                insideFrontInterface.openChatPane();
            } else {
                chatRequested = true;
            }
            return false;
        };
        const initPlugin = function(ref) {
            $(ref).find('.live-chat').on("click", function() {
                openChatButtonOnClick();
                $(ref).find('.switch-button.activated').trigger('click');
            });
            $(ref).find('.products-help-chat').off('click').on("click", function() {
                console.log('test2');
            });
            $(ref).find('.omnitok').on("click", function() {
                console.log('test1')
                window.OmnitokChat.livechat.showMainMenu()
                $(ref).find('.switch-button.activated').trigger('click');
            });
            $(ref).find('.feed-back#feedBackButton').parents(".group-box").on("click", function() {
                if ($('#QSIFeedbackButton-btn').length > 0) {
                    window._qsie = window._qsie || [];
                    window._qsie.push('feedbackbutton');
                    $('#QSIFeedbackButton-btn').trigger('click');
                }
                $(ref).find('.switch-button.activated').trigger('click');
            });
        };
        $('#right-contact-us').initContactUs({
            "callback": initPlugin,
            "isEnableNewContact": true
        });
        $('#top-contact-us').initContactUs({
            "fixedOn": "#contact-us-top",
            "callback": initPlugin
        });
        $(document).on('click', '#right-contact-us .switch-button', function() {
           var rightContactUs = $('#right-contact-us'),
               clickEle = rightContactUs.find('.switch-button');
           if (!clickEle.hasClass('activated')) {
               rightContactUs.removeClass('position-unset');
           }
       });
    });
</script>




