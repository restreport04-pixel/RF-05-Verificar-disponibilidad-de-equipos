                    </li>
                    <!-- /ko -->
                    <!-- /ko -->
                    <li class="compare-action even last">
                        <div class="has-item" data-bind="style: {display: category.count ? &#39;block&#39; : &#39;none&#39;}" style="display: none;">
                            <button class="action primary compare-now disabled" data-bind="click: $parent.saveCurrentUrl, attr: {compare_url: compare_url, class: count &lt; 2 ? &#39;action primary compare-now disabled&#39; : &#39;action primary compare-now&#39;, &#39;data-gtm-category&#39;: &#39;compareModels&#39;, &#39;data-gtm-value&#39;: data_gtm_value}" compare_url="https://www.hp.com/co-es/shop/catalog/product_compare/index/category/accessories/" data-gtm-category="compareModels" data-gtm-value="">
                                <span>Comparar ahora</span>
                            </button>
                            <div class="action primary remove-all" data-bind="attr: {&#39;data-post&#39;: remove_all_url, &#39;data-category-url-key&#39;: url_key}" data-post="{&quot;action&quot;:&quot;https:\/\/www.hp.com\/co-es\/shop\/hpols_catalog\/product_compare\/removeall\/&quot;,&quot;data&quot;:{&quot;category&quot;:&quot;accessories&quot;,&quot;uenc&quot;:&quot;&quot;}}" data-category-url-key="accessories">
                                <span>Borrar todo</span>
                            </div>
                        </div>
                        <div class="no-item" data-bind="style: {display: !category.count ? &#39;block&#39; : &#39;none&#39;}" style="display: block;">
                            No se agregó un producto a la lista de comparación                        </div>
                    </li>
                </ul>
            </div>
        </div>
