.0008973 Z" class="bv-rnr__jcyw8r-2 kuyfUA"></path><defs class="bv-rnr__jcyw8r-5 jxGIIT"><lineargradient id="bv_rating_summary_star_filled_1_4_0_product1_160_375177534" x1="0%" y1="0%" x2="100%" y2="0%" class="bv-rnr__jcyw8r-4 iwIblO"><stop offset="0%" class="bv-rnr__jcyw8r-3 kLEbUu"></stop><stop offset="1%" class="bv-rnr__jcyw8r-3 hWRNAF"></stop></lineargradient></defs></svg></abbr><span class="bv-rnr__bm6gry-0 cViGBA">3 de 5 estrellas.</span></div><div class="bv-rnr__sc-16dr7i1-21 bLRaeH"><h3 itemprop="name" aria-describedby="bv-review-375177534" class="bv-rnr__sc-16dr7i1-17 dGIPhH">Limitada, no se siente ese poder de video extra</h3><div class="bv-rnr__tbt1zd-0 gIIhxN"><div class="bv-rnr__tbt1zd-1 bSWXQl"><div class="bv-rnr__sc-16dr7i1-20 hEOEnK"><ul role="presentation" class="bv-rnr__sc-1nu2m9b-0 bdOpfs"><li role="presentation" class="bv-rnr__i18wyj-0 epXgbk"><button aria-label="Comprador verificado" aria-hidden="false" tabindex="0" aria-expanded="false" class="bv-rnr__i18wyj-4 kLftdx"><span class="bv-rnr__sc-1y8lyw5-0 gIgVUl badge-label"><span aria-hidden="true" class="bv-rnr__sc-1y8lyw5-1 duBGiu"><img alt="" src="https://apps.bazaarvoice.com/deployments/hp-colombia/main_site/production/es_CO/images/badgeImages/verifiedPurchaser" class="bv-rnr__sc-1aslhq8-0 dLXqSJ"></span><span class="bv-rnr__sc-1y8lyw5-2 vNitB">Comprador verificado</span></span></button></li></ul></div><div class="bv-rnr__g3jej5-0 JgZrm"><meta itemprop="dateCreated" content="2026-01-04T17:12:31.000+00:00"><meta itemprop="datePublished" content="2026-04-22T03:52:06.000+00:00"><span class="bv-rnr__g3jej5-1 jolJQc">hace 4 meses</span></div></div></div></div></div><div class="bv-rnr__sc-16dr7i1-14 fKdXxQ"><div data-bv-v="contentSummary" class="bv-rnr__sc-16dr7i1-7 hFQwhN"><div tabindex="-1" id="bv-review-text-375177534" itemprop="reviewBody" class="bv-rnr__sc-16dr7i1-3 fLXmig">he tenido la r7 serie 5000 en pavilon, 16gb ram, 512gb, con un rendimiento muy bueno, al hacer esta nueva inversion no senti diferencia, todo lo contrario, todo más lento, la pantalla con menor percepcion de brillo y precision de colores, enchufada se siente algo mejor pero no lo necesario, uso programas originales, si es para uso domestico es buena, pero cuando la exiges un poco no rinde. ojo no edito video, solo proceso fotos. Busque informacion y dicen que hp limita los watts por eso no rinde y no hay forma de liberar el poder completo de la rtx.</div><div class="bv-rnr__sc-16dr7i1-13 flweSz"><div class="bv-rnr__sc-1i2zvgg-2 jReCpT"><div class="bv-rnr__sc-1i2zvgg-0 ceEEwL"><span class="bv-rnr__sc-1y8lyw5-0 gIgVUl badge-label"><span aria-hidden="true" class="bv-rnr__sc-1y8lyw5-1 duBGiu"><svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" version="1" viewBox="0 0 243 230" aria-hidden="true" class="bv-rnr__qdad0u-0 gwUSq"><path d="M1033 2254c-343-57-646-279-805-589-114-224-152-453-113-693 77-475 452-850 927-927 607-98 1184 318 1283 927 77 476-163 950-590 1170-223 114-463 152-702 112zm-170-625c12-6 97-86 189-177l168-167 172 172c189 187 208 199 267 167 39-21 57-60 46-102-4-16-73-94-178-199l-171-173 171-172c105-106 174-184 178-200 11-42-7-81-46-102-59-32-78-20-266 167l-173 171-172-171C937 733 865 669 846 664c-63-15-127 50-111 113 4 18 71 93 178 201l171 172-171 173c-110 110-174 182-179 201-18 74 62 139 129 105z" transform="matrix(.1 0 0 -.1 0 230)"></path></svg></span><span class="bv-rnr__sc-1y8lyw5-2 vNitB"></span></span></div><p class="bv-rnr__sc-1i2zvgg-1 iszExj">No, No recomiendo este producto.</p></div></div><div class="bv-rnr__sc-1grr47e-0 hjOpfY"><div class="bv-rnr__sc-1grr47e-1 gHTJFH"><img src="https://photos-us.bazaarvoice.com/photo/2/cGhvdG86YXR0cmlidXRpb25sb2dvMg/30b3a8ed-1da7-4dae-ba6e-303e70ad9b1e" alt="" width="50" height="50"></div><div class="bv-rnr__sc-1grr47e-2 kdXGEG"><p class="bv-rnr__sc-1grr47e-3 hCiaBm">Publicado originalmente en el sitio web HP.com Peru para Laptop HP Gaming VICTUS Victus Gaming 15-fb3021la, AMD Ryzen 7, 16 GB GPU NVIDIA® GeForce RTX™ 405