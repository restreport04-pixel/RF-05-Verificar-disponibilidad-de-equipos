<style>

.chat-list {
   position: relative;
   box-shadow: 0 3px 3px rgba(0,0,0,.15);
}
.chat-list:before, .chat-list:after {
    border-bottom-style: solid;
    content: '';
    display: block;
    height: 0;
    position: absolute;
    width: 0;
}

.chat-list:before {
    border: 11px solid;
    border-color: transparent transparent #bbb;
    top: -22px;
    right: 30px;
}
.chat-list:after {
    border: 10px solid;
    border-color: transparent transparent #fff;
    top: -20px;
    right: 31px;
    z-index: 99;
}
#homeChat .phone_text > span {
    display: inline-block;
    position: relative;
}

#homeChat .phone_text > span:before {
    font-family: "hpIconfont";
    content: '\e60b';
    font-size: 28px;
    font-weight: 400;
    position: absolute;
    z-index: 2;
    width: 20px;
    height: 20px;
    left: -30px;
}
@media screen and (max-width: 767px) {
#homeChat {
display: none;
}
}
</style>
