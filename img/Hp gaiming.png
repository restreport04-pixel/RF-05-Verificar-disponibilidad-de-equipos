    </div><div data-dy-embedded-object="true"><div class="dy_unit dy_smart_object_3537869 dy-auto-embedder dyother dyMonitor" data-dy-exp-id="2400950" data-dy-var-id="30632515" data-dy-ver-data="15287983::0:1778538468224:44567:21156:1:0:0.11112581100314856:0.8784427589271218" data-dy-att-method="0" data-dy-att-seq="21156" data-adid="smart_object_3537869||387|||"><style>.dy-copilot-badge {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  margin-bottom: 16px;
  position: relative;
  font-family: inherit;
}

.dy-copilot-text {
  font-size: 12px;
}

.dy-tooltip {
  position: relative;
}

.dy-tooltip-link {
  color: #165dba;
  font-size: 16px;
  text-decoration: underline;
}

.dy-tooltip-link:hover {
  text-decoration: none;
}

.dy-tooltip-btn {
  width: 20px;
  height: 20px;
  border-radius: 50%;
  border: none;
  background: #767676;
  cursor: pointer;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0;
  margin: 0;
  transition: background 0.2s, fill 0.2s;
}

.dy-tooltip-btn svg {
  fill: #fff;
  transition: fill 0.2s;
}

.dy-tooltip-btn:hover, .dy-tooltip-btn:focus {
  background: #D3D3D3 !important;
}

.dy-tooltip-btn:hover svg, .dy-tooltip-btn:focus svg {
  fill: #000;
}

.dy-tooltip-box {
  display: none;
  position: absolute;
  top: 32px;
  right: -6px;
  background: #fff;
  border-radius: 6px;
  box-shadow: 0 3px 6px rgba(0,0,0,0.2);
  width: 320px;
  z-index: 999;
  padding: 1.25rem 1rem 1rem 1rem;
}

.dy-tooltip.active .dy-tooltip-box {
  display: block;
}

.dy-tooltip-box::before {
  content: "";
  position: absolute;
  top: -6px;
  right: 10px;
  width: 12px;
  height: 12px;
  background-color: #fff;
  transform: rotate(45deg);
  box-shadow: -1px -1px 2px rgba(44,48,56,.1);
  z-index: -1;
}

.dy-tooltip-close {
  position: absolute;
  top: 8px;
  right: 8px;
  width: 32px;
  height: 32px;
  border-radius: 50%;
  border: 1px solid #2c3038;
  background: #fff;
  cursor: pointer;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: all .25s ease-out, background 0.2s, border-color 0.2s;
  padding: 0;
}

.dy-tooltip-close svg {
  fill: #000;
  transition: fill 0.2s;
}

.dy-tooltip-close:hover {
  background: #767676;
  border-color: #767676;
}

.dy-tooltip-close:hover svg {
  fill: #fff;
}

.dy-tooltip-title {
  font-weight: bold;
  margin: 0 0 0.25rem 0;
  text-transform: uppercase;
  font-size: 13px;
}

.dy-tooltip-description {
  font-size: 16px;
  padding: 16px 0;
  line-height: 22px;
}

@media screen and (max-width: 1023px) {
  .dy-tooltip-box {
	  display: none;
	  position: absolute;
	  top: 32px;
	  left: -90px;
	  background: #fff;
	  border-radius: 6px;
	  box-shadow: 0 3px 6px rgba(0,0,0,0.2);
	  width: 320px;
	  z-index: 999;
	  padding: 1.25rem 1rem 1rem 1rem;
   }
   .dy-tooltip-box::before {
	  content: "";
	  position: absolute;
	  top: -6px;
	  left: 94px;
	  width: 12px;
	  height: 12px;
	  background-color: #fff;
	  transform: rotate(45deg);
	  box-shadow: -1px -1px 2px rgba(44,48,56,.1);
	  z-index: -1;
	}
}

@media screen and (max-width: 767px) {
  .TriggerElement-module_defaultButton__QdvUI .TriggerElement-module_questionMark__O6ZKd,
  .Tooltip-module_root__aZxUO {
    display: none !important;
  }

  .hyperlink-text {
    text-decoration: underline !important;
  }

  .dy-copilot-badge {
    gap: 4px;
  }
}

@media screen and (max-width: 387px) {
  .dy-copilot-text {
    font-size: 11px;
  }
