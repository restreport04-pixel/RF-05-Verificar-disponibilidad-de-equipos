    min-height: 240px;
    background-color: var(--color-addi-comp-five-base);
}

.addi-home-banner-default-content-container{
    display: flex;
    flex-direction: column;
    justify-content: center;
}

.addi-home-banner-default-content-container__title {
    font-family: 'Malory-bold', 'system-ui';
    font-weight: 700;
    font-size:  32px;
    line-height: 35px;
    text-align: center;
    margin: 0 0 15px;
    color: var(--color-addi-gray-lighten4);
}

.addi-home-banner-default-content-container__logo {
    width: 2em;
}

.addi-home-banner-content-container__button--outline {
    font-family: 'Mallory', 'system-ui';
    font-weight: 700;
    font-size: 14px;
    line-height: 14px;
    display: flex;
    background-color: var(--color-addi-primary-active);
    border-radius: 25px;
    border: 1px solid var(--color-addi-font-over-dark);
    color: var(--color-addi-font-over-dark);
    justify-content: center;
    padding: 9px 0 10px;
    cursor: pointer;
}

@media screen and (min-width: 600px) {
    .addi-home-banner-default {
        padding: 20px;
        min-height: 76px;
    }

    .addi-home-banner-default-content-container{
        flex-direction: row;
        justify-content: space-between;
        align-items: center;
    }

    .addi-home-banner-default-content-container__title {    
        display:flex;
        align-items: center;
        font-size:  20px;
        line-height: 24px;
        text-align: initial;
        margin: 0;
    }

    .addi-home-banner-default-content-container__logo {
        width: 3em;
        margin-top: 1px;
    }

    .addi-home-banner-content-container__button--outline {
        width: 130px;
        padding: 7px 0 8px;
    }
}   

@media screen and (min-width: 768px) {
    .addi-home-banner-default {
        padding: 30px;
        min-height: 120px;
    }

    .addi-home-banner-default-content-container__title {    
        font-size:  32px;
        line-height: 35px;
    }

    .addi-home-banner-default-content-container__logo {
        margin-top: 2px;
    }

    .addi-home-banner-content-container__button--outline {
        width: 195px;
        height: 48px;
        font-size: 20px;
        line-height: 20px;
        padding: 13px 0 14px;
    }
}
