    }

    addi-onboarding-br .addi-modal_header button {
        margin-right: 0;
    }
}
</style><style>.addi-one-click-checkout {
    display: none;
}

.addi-one-click-checkout.addi-one-click-checkout--show {
    display: inline-block;
    margin-bottom: 10px;
}

.addi-one-click-checkout .addi-one-click-checkout__button {
    outline: none;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    border: 0;
    background-color: var(--color-addi-primary-active);
    color: var(--color-addi-background-white);
    width: 100%;
    padding: 19px;
    font-family: 'Mallory', 'system-ui';
    font-style: normal;
    font-weight: 700;
    font-size: 16px;
}

.addi-one-click-checkout .addi-one-click-checkout__button:disabled {
