}

/* HEADER */
.block-minicart.empty .dy-minicart_line {
  background-color: #D1D1D1;
  height: 1px;
  margin: 16px 0;
  width: 100%;
}

.block-minicart.empty .dy-minicart > h2 {
  font-size: 18px;
  font-weight: 400;
  line-height: 22px;
  margin: 0 0 16px 0;
}

/* CARD */
.block-minicart.empty .dy-minicart .dy-minicart_body {
  display: flex;
  flex-direction: column;
  gap: 16px;
}

.block-minicart.empty .dy-minicart .dy-minicart_card {
  border: 1px solid #CCCCCC;
  display: flex;
  gap: 12px;  
  flex-direction: row;
  flex-wrap: nowrap;
  padding: 8px;
}

.block-minicart.empty .dy-minicart .dy-minicart_card .dy__image {
  cursor: pointer;
  display: block;
  width: 90px;
}

.block-minicart.empty .dy-minicart .dy-minicart_card .dy__body {
  display: flex;
  flex-direction: column;
  width: calc(100% - 102px);
}

.block-minicart.empty .dy-minicart .dy-minicart_card .dy__body h3 {
  color: #2C3038;
  font-size: 12px;
  font-weight: 400;
  line-height: 16px;
  margin: 0;
}

.block-minicart.empty .dy-minicart .dy-minicart_card .dy__specs ul {
  display: flex;
  flex-direction: row;
  flex-wrap: wrap;
  margin: 4px 0;
  padding: 0;
}

.block-minicart.empty .dy-minicart .dy-minicart_card .dy__specs ul li {
  display: contents;
  color: #5A5A5A !important;
  cursor: default;
  font-size: 12px !important;
  font-style: normal;
  font-weight: 400 !important;
  margin: 0 !important;
  line-height: 16px !important;
}

.block-minicart.empty .dy-minicart .dy-minicart_card .dy__specs ul li:not(:last-child) {
  margin-right: 4px !important;
}

.block-minicart.empty .dy-minicart .dy-minicart_card .dy__dissc {
    height: 16px;
    margin-top: auto;
}

.block-minicart.empty .dy-minicart .dy-minicart_card .dy__price {
  color: #2C3038;
  font-size: 12px;
  font-style: normal;
  font-weight: 700;
  line-height: 16px;
}

.block-minicart.empty .dy-minicart .dy-minicart_card .dy__dissc .dy__save {
  color: #2C3038;
  font-size: 12px;
  font-style: normal;
  font-weight: 700;
  line-height: 16px;
  margin-left: 4px;
}

.block-minicart.empty .dy-minicart .dy-minicart_card .dy__dissc .dy__off > span {
  color: #767676;
  font-size: 12px;
  font-style: normal;
  font-weight: 400;
  line-height: 16px;
  position: relative;
}

.block-minicart.empty .dy-minicart .dy-minicart_card .dy__dissc .dy__off > span::after {
  width: 100%;
  height: 1px;
  background: #656263;
  content: '';
  display: block;
  transform: rotate(-7deg);
  -webkit-transform: rotate(-7deg);
  -moz-transform: rotate(-7deg);
  -ms-transform: rotate(-7deg);
  bottom: 8px;
  position: absolute;
}

.block-minicart.empty .dy-minicart .dy-minicart_card .hidden-block {
  visibility: hidden !important;
}

.block-minicart.empty .block-content > .minicart-items-wrapper:has(ol li) ~ div[data-dy-embedded-object] {
  display: none !important;
}

@media screen and (max-width: 1919.5px) { /* XL */
  .minicart-wrapper .block-minicart.empty { width: 394px !important; }
}
@media screen and (max-width: 480px) {
  .minicart-wrapper .block-minicart.empty {
    padding: 15px 5px !important;
    width: 284px !important;
  }
  .block-minicart.empty .block-content > strong.subtitle.empty {
    font-size: 16px !important;
  }
}</style><div class="dy-minicart" style="display: none">
