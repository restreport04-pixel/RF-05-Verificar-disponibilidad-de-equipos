            domReady(function () {
                if (!$('.action.tocart').hasClass('unavailable')) {
                    $('.action.tocart').attr('disabled', 'disabled');
                }
                $(".action.tocart span").each(function() {
                    if($(this).find("img").length == 0) {
                        $(this).prepend('<img class="cart-button-loading" style="height: 14px;" src="' + loadingImg + '">');
                    }
                })
            });
            document.addEventListener('readystatechange', () => {
                if (document.readyState === 'complete') {
                    if (!$('.action.tocart').hasClass('unavailable')) {
                        $('.action.tocart').attr('disabled', false);
                    }
                    $('.action.tocart span .cart-button-loading').remove();
                }
            });
