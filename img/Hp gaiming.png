<script id="edd-template" type="text/x-magento-template">
    <div class="deliver-items delivery-box">
        <% _.each(items, function(item, name) { %>
        <% if (item.title) { %>
        <div class="deliver-item">
            <div class="edd">
                <div class="title stellar-bold__small"><%- item.title %></div>
                <span class="edd-message stellar-body__extra-small"><%- item.edd %></span>
            </div>
        </div>
        <% } %>
        <% }); %>
    </div>
</script>

                    
                    <div class="input-action noborder   ">
                                                <button class="primary check-edd check-edd-pin check-pincode-btn" data-type="D" data-bind="event: {click: checkEdd}">
                            <span data-bind="i18n: checkText">comprobar</span>
                        </button>
                        <button class="primary check-shipping-availability right-popup-hide" data-bind="click: checkShippingAvailability">
                        <span data-bind="text: checkShippingText">Consulta disponibilidad de envío</span>
                        </button>
                    </div>
                    <div class="delivery-information" style="width:100%;" data-bind="visible: deliveryContainerShow">
                                                    <div class="estimate">
                                <span class="error stellar-body__extra-small" data-bind="text: eddError, visible: eddErrorShow" style="display: none;"></span>
                            </div>
                                                <div class="delivery-days">
                            <div class="stock-status" data-bind="visible: !eddErrorShow()">
                                <!-- Get delivery business days -->
                                                                                                <span class="stock in-stock-messaging" data-status="product-available" data-stock="Disponible">
                                            Disponible                                                                                                    </span></div>
                        </div>
                    </div>
                    <div id="click_and_collect_popup" class="checked" data-bind="visible: deliveryContainerShow"></div>
                    <div class="click-and-collect-error-message"></div>
                </div>
            </div>
                    </div>
    <script id="edd-message-template" type="text/x-magento-template">
        <div class="deliver-items delivery-box">
            <% if (back_order || is_pre_order) { %>
            <div class="deliver-item">
                <div class="edd">
                    <span class="edd-message stellar-body__extra-small"><%- message %></span>
                </div>
            </div>
            <% } else { %>
            <% _.each(items, function(item, name) { %>
            <% if (item.title) { %>
            <div class="deliver-item">
                <div class="edd">
                    <div class="title stellar-bold__small"><%- item.title %></div>
                    <span class="edd-message stellar-body__extra-small"><%- item.edd %></span>
                </div>
            </div>
            <% } %>
            <% }); %>
            <% } %>
        </div>
    </script>

    

    
            
