      <style id="edgio-styles">
        html.ignore-hide, html.ignore-hide body.ignore-hide {
          display: block !important;
          opacity: 1 !important;
          visibility: visible !important;
        }
        .page-header {
          top: 0px !important;
        }
        .page-header.page-header-top #edgio-promo-banner-wrapper {
            display: none !important;
        }
        .page-header .message.global.inside-notice {
            position: relative;
            margin-top: 0 !important;
        }
        .c-button.black-button {
          background: #000000 !important;
          line-height: 34px !important;
          color: #ffffff !important;
        }

        .contact-us-container:not(.activated) {
          display: none;
        }
        #edgio-placeholder-home,
        #edgio-placeholder-plp,
        #edgio-placeholder-pdp,
        #edgio-placeholder-image {
          position: absolute;
          top: 0;
          left: 0;
          z-index: -1;
          display: block;
          pointer-events: none;
        }
        #edgio-placeholder-plp,
        #edgio-placeholder-pdp,
        #edgio-placeholder-image {
          overflow: hidden;
        }
        .transparent-button {
          line-height: 34px !important;
        }
        #edgio-placeholder-pdp-image {
          position: absolute;
          top: 0;
          left: 0;
          width: 100%;
          display: block;
          pointer-events: none;
          height: 80vh;
        }
        body.page-products #maincontent.page-main .column.main .grid.products-grid > ol.product-items.grid, .product-items.grid {
          padding: 1px;
        }
        @media screen and (min-width: 1200px){
          body.page-products #maincontent.page-main .column.main .grid.products-grid.wrapper {
            position: relative;
          }
        }
        .product.media {
          min-height: 50vh;
        }
        #edgio-placeholder-image {
          width: 100%;
          height: calc(0.3 * 100vw);
          max-height: 150px;
          min-height: 100px;
        }
        #edgio-placeholder-image.edgio-home-page {
          height: 96vh;
          max-height: 96vh;
          width: 100%;
          overflow: visible;
        }
        .edgio-background-layout {
          background-color: #fff;
          height: 100%;
          max-height: 100vh;
          width: 100%;
          position: absolute;
          overflow: hidden;
          z-index: -1;
          pointer-events: none;
          left: 0;
        }
        #edgio-placeholder-plp {
          width: 100%;
        }
        .homepage-carousel-banner-container {
          position: relative;
        }
        #edgio-placeholder-home img {
          width: 100vw;
        }
        .product-items .item.product.product-item {
          min-height: 500px;
          min-width: 250px;
        }
        body > #edgio-promo-banner-wrapper {
          display: none;
        }
        .minicart-items-wrapper {
          height: auto !important;
        }
        @media screen and (max-width: 767px) {
          .product.media {
            min-height: 50vh;
          }
        }
        @media screen and (min-width: 768px) {
          .fotorama__wrap--no-controls .fotorama__fullscreen-icon {
            transform: none !important;
          }
        }
      </style>
