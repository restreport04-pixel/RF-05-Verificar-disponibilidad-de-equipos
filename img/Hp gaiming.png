<script>
(function () {
    const initHeaderChat = () => {
        const headerChatHidden = document.getElementById('headerChatHidden');
        const headerRight = document.querySelector('.header-right');
        const homeChatExists = document.getElementById('homeChat');

        // Check if source elements exist and target hasn't been created yet
        if (!headerChatHidden || !headerRight || homeChatExists) {
            return;
        }

        const headerChatHtml = headerChatHidden.innerHTML;

        // Create the homeChat container
        const homeChat = document.createElement('div');
        homeChat.id = 'homeChat';
        homeChat.innerHTML = headerChatHtml;

        // Prepend homeChat to the .header-right container
        headerRight.insertBefore(homeChat, headerRight.firstChild);

        // Bind Hover events (mouseenter/mouseleave)
        homeChat.addEventListener('mouseenter', () => {
            // Hide all submenus (equivalent to $('.submenu').hide())
            document.querySelectorAll('.submenu').forEach(el => {
                el.style.display = 'none';
            });
            
            // Display the ul inside homeChat (equivalent to $("#homeChat ul").css("display","block"))
            const ul = homeChat.querySelector('ul');
            if (ul) ul.style.display = 'block';
        });

        homeChat.addEventListener('mouseleave', () => {
            // Hide the ul inside homeChat
            const ul = homeChat.querySelector('ul');
            if (ul) ul.style.display = 'none';
        });
    };

    // Ensure execution after DOM is fully loaded (equivalent to $(function(){...}))
    if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', initHeaderChat);
    } else {
        initHeaderChat();
    }
})();
</script>


